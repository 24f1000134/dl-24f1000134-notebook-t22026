    "    text = text.lower()\n",
    "\n",
    "    text = text.translate(str.maketrans('', '', string.punctuation))\n",
    " \n",
    "    return text.split()\n",
    "\n",
    "unique_words = set()\n",
    "for prompt in train_df['prompt']:\n",
    "    unique_words.update(clean_text(prompt))\n",
